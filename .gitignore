!frontend/src/**/*.svg
!frontend/src/**/*.png

# --- Secrets / local config ---
.env
.env.*
!.env.example
*.pem
*.key
config.local.*

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
