*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
*.egg

# --- Frontend build (optional: remove dist/ line if you want to commit built UI) ---
frontend/dist/
*.tsbuildinfo

# --- App data / index (private — never push) ---
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
embeddings.bin
embeddings*.bin
thumbnails/
cache/
.cache/
