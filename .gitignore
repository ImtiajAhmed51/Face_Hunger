*.npz

# --- Models / downloads (large) ---
*.onnx
*.pt
*.pth
*.bin
models/
.insightface/
~/.insightface/

# --- Media (originals stay on your disk, not in repo) ---
*.mp4
*.mov
*.avi
*.mkv
*.jpg
*.jpeg
*.png
*.heic
*.webp
